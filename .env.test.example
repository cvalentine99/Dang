# Copy to .env.test (git-ignored) to run the DB-gated suites locally:
#   cp .env.test.example .env.test && pnpm test:db
#
# Loaded by server/testHelpers/loadTestEnv.ts (vitest setupFiles) and by the
# globalSetup in server/testHelpers/testDb.ts. `.env` is never loaded by tests.
#
# DATABASE_URL MUST name a dedicated test database ending in `_test`. The
# globalSetup creates it if missing and applies ./drizzle migrations to it;
# DB-gated suites insert, update and truncate rows. Never use the live `dang`
# database. (The user below needs CREATE on dang_test, or create it yourself:
#   CREATE DATABASE dang_test; GRANT ALL ON dang_test.* TO 'dang'@'%';)
DATABASE_URL=mysql://dang:dang@127.0.0.1:3307/dang_test

# Makes a missing DATABASE_URL an error instead of a silent skip
# (`pnpm test:db` sets this itself).
TEST_DB=1

# Session signing for auth tests (any 32+ char value; not a real secret).
JWT_SECRET=test-secret-that-is-long-enough-32chars
