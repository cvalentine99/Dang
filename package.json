  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "SELF_HOSTED=1 vite build && node -e \"const h=require('fs').readFileSync('dist/public/index.html','utf8');const m=h.match(/<script(?![^>]*\\bsrc=)[^>]*>/gi);if(m){console.error('H-C3: inline <script> in dist/public/index.html (blocked by prod CSP):',m);process.exit(1)}\" && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --project unit --project client",
    "test:unit": "vitest run --project unit",
    "test:client": "vitest run --project client",
    "test:source-checks": "vitest run --project source-checks",
    "test:db": "TEST_DB=1 vitest run --project unit",
    "test:db:known-failing": "TEST_DB=1 DB_KNOWN_FAILING=only vitest run --project unit",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:ui-parity": "node scripts/audit-ui-param-parity.mjs",
    "audit:broker": "node scripts/verify-param-counts.mjs",
    "audit:openapi": "node scripts/diff-wazuh-openapi.mjs",
